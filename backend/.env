# Configuração do Banco de Dados
# Substitua os valores abaixo pelas credenciais do seu banco PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_seu_banco

# Configuração de Segurança para JWT
# Use uma string longa e aleatória (você pode gerar uma no terminal com: openssl rand -hex 32)
SECRET_KEY=sua_chave_secreta_super_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
